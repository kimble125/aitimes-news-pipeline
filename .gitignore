# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Environment / secrets
.env
.env.local
*.pem

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Logs
logs/*.log
!logs/.gitkeep

# Data artifacts (keep directory structure)
data/*.db
data/*.sqlite
data/*.sqlite3
data/raw/*
!data/raw/.gitkeep
data/clean/*
!data/clean/.gitkeep

# Outputs (optional: keep structure, ignore generated files)
outputs/charts/*.png
!outputs/charts/.gitkeep
outputs/reports/*
!outputs/reports/.gitkeep
outputs/*.csv
outputs/*.jsonl
outputs/*.xlsx

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
