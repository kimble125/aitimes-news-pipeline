{
  "sources": {
    "aitimes": {
      "name": "AI타임스",
      "base_url": "https://www.aitimes.com/",
      "rss_urls": [
        "https://www.aitimes.com/rss/allArticle.xml",
        "https://www.aitimes.com/rss/clickTop.xml"
      ],
      "list_url_templates": [
        "https://www.aitimes.com/news/articleList.html?page={page}&view_type=sm"
      ],
      "default_method": "rss",
      "user_agent": "aitimes-news-pipeline/0.1 (academic assignment; contact: team)"
    }
  },
  "duplicate_policy": "upsert",
  "duplicate_keys": ["url", "guid"],
  "timeouts": {
    "http_connect_sec": 10,
    "http_read_sec": 30,
    "ai_request_sec": 60
  },
  "crawl": {
    "delay_sec": 1.5,
    "max_pages": 1,
    "max_articles_per_run": 50,
    "respect_robots_txt": true
  },
  "paths": {
    "db": "data/pipeline.db",
    "raw_dir": "data/raw",
    "clean_dir": "data/clean",
    "charts_dir": "outputs/charts",
    "reports_dir": "outputs/reports",
    "logs_dir": "logs"
  },
  "report": {
    "top_n": 10,
    "default_format": "md"
  },
  "export": {
    "default_formats": ["csv", "jsonl"]
  },
  "logging": {
    "level": "INFO",
    "file": "logs/pipeline.log"
  }
}
